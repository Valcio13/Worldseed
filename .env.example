# Public Hemi Sepolia contract address. Safe to expose in a frontend build.
VITE_WORLDSEED_CONTRACT_ADDRESS=0x133B0fDbaC7D6535C68Be5945d15C328F3d371E4

# V3 contest UI. Production V3 verifier is configured on Hemi Sepolia.
VITE_ENABLE_V3_IDLE=true
# Deployed WorldseedGameV3 contract on Hemi Sepolia (chain ID 743111).
VITE_WORLDSEED_V3_CONTRACT_ADDRESS=0x3764b775a099fe887B164f85eB95dA6E0C22151D
# Separate verifier Worker base URL. The frontend appends /api/v3 to API routes.
VITE_VERIFIER_API_URL=https://worldseed-v3-verifier.valcio222.workers.dev

# Hardhat deployment settings; keep the private key out of VITE_* variables.
HEMI_SEPOLIA_RPC_URL=
HEMI_SEPOLIA_PRIVATE_KEY=

# Reserved for a separately authorized Mainnet release; not used by contest testing.
HEMI_MAINNET_RPC_URL=
HEMI_MAINNET_PRIVATE_KEY=

# Local V3 verifier only; use disposable Hardhat keys and never reuse these on a public chain.
WORLDSEED_V3_LOCAL_ATTESTER_PRIVATE_KEY=
WORLDSEED_V3_LOCAL_CONTRACT_ADDRESS=
WORLDSEED_V3_LOCAL_RPC_URL=http://127.0.0.1:8545
WORLDSEED_V3_LOCAL_DB_PATH=.local/worldseed-v3.sqlite
WORLDSEED_V3_LOCAL_ALLOWED_ORIGIN=http://localhost:5173
WORLDSEED_V3_LOCAL_PORT=8788
