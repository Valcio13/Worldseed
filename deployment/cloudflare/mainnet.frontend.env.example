# Public build-time variables only for the separate Mainnet frontend.
# Never place RPC credentials, private keys, or other secrets here.
VITE_WORLDSEED_NETWORK=hemi-mainnet
VITE_ENABLE_V3_IDLE=true
VITE_WORLDSEED_V3_MAINNET_CONTRACT_ADDRESS=0x133B0fDbaC7D6535C68Be5945d15C328F3d371E4
# Intentionally empty: Mainnet launch is V3-only; do not configure the legacy V1 contract.
VITE_WORLDSEED_MAINNET_CONTRACT_ADDRESS=
VITE_VERIFIER_API_URL_MAINNET=https://worldseed-v3-verifier-mainnet.valcio222.workers.dev
