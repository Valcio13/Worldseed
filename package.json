{
  "name": "worldseed-shattered-isles",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty && tsc -p tsconfig.server.json --pretty",
    "typecheck:worker": "tsc -p tsconfig.worker.json --pretty",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run src",
    "test:worker": "node --import tsx --test scripts/d1VerifierStore.test.ts",
    "test:watch": "vitest",
    "contract:compile": "hardhat compile --build-profile production",
    "contract:test": "hardhat test --build-profile production",
    "contract:deploy:testnet": "hardhat run scripts/deploy-testnet.ts --network hemiSepolia --build-profile production",
    "contract:deploy:v3": "hardhat run scripts/deploy-v3.ts --build-profile production",
    "verifier:dev": "node --env-file=.env.local --import tsx src/incremental/server/localServer.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.2",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "viem": "latest",
    "vite": "latest",
    "wagmi": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@nomicfoundation/hardhat-node-test-runner": "^3.1.0",
    "@nomicfoundation/hardhat-viem": "^3.0.9",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "hardhat": "^3.19.0",
    "jsdom": "latest",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "latest",
    "vitest": "latest",
    "wrangler": "^4.151.1"
  }
}
